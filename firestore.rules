// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: buses
// Document ID: {busId}
// Fields:
//   - lat: number (required) - Latitude
//   - lng: number (required) - Longitude
//   - speed: number (optional) - Speed km/h
//   - lastUpdated: string (required, ISO 8601) - Last update time
//   - routeId: string (required) - Route ID
//   - driverId: string (required) - UID of driver
//   - status: string (optional, enum) - on-time, delayed, early
//   - occupancy: string (optional, enum) - low, medium, high
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "lofiaab@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidBus(data) {
      return data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.lastUpdated is string && data.lastUpdated.size() < 100 &&
             data.routeId is string && data.routeId.size() < 50 &&
             data.driverId is string && data.driverId.size() < 128 &&
             (!('speed' in data) || (data.speed is number && data.speed >= 0 && data.speed < 200)) &&
             (!('status' in data) || (data.status in ['on-time', 'delayed', 'early'])) &&
             (!('occupancy' in data) || (data.occupancy in ['low', 'medium', 'high']));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /buses/{busId} {
      // Anyone can track buses
      allow read: if true;
      
      // Drivers can create/update their own bus entry
      // Admin can do anything
      allow create: if isAuthenticated() && isValidBus(request.resource.data) && 
                    (request.resource.data.driverId == request.auth.uid || isAdmin());
                    
      allow update: if isAuthenticated() && isValidBus(request.resource.data) && 
                    (resource.data.driverId == request.auth.uid || isAdmin());
                    
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
